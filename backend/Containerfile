FROM docker.io/library/eclipse-temurin:25-jdk-alpine AS build
WORKDIR /workspace
COPY --chmod=0755 backend/mvnw ./mvnw
COPY backend/.mvn ./.mvn
COPY backend/pom.xml ./pom.xml
RUN ./mvnw -B -ntp dependency:go-offline
COPY backend/src ./src
COPY contracts/openapi.yaml /contracts/openapi.yaml
RUN ./mvnw -B -ntp -Dmaven.test.skip=true package

FROM docker.io/library/eclipse-temurin:25-jre-alpine AS runtime
RUN addgroup -S -g 10001 platform && adduser -S -u 10001 -G platform platform
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/target/platform.jar ./platform.jar
USER 10001:10001
EXPOSE 8080 9090
ENTRYPOINT ["java", "-jar", "/app/platform.jar"]
