FROM docker.io/library/node:24.16.0-alpine AS dependencies
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
RUN npm ci --no-fund --no-audit

FROM dependencies AS build
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend ./frontend
RUN npm run build --workspace frontend

FROM docker.io/library/node:24.16.0-alpine AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
RUN addgroup -S -g 10001 platform && adduser -S -u 10001 -G platform platform
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/frontend/.next/standalone ./
COPY --from=build --chown=10001:10001 /workspace/frontend/.next/static ./frontend/.next/static
COPY --from=build --chown=10001:10001 /workspace/frontend/public ./frontend/public
USER 10001:10001
EXPOSE 3000
CMD ["node", "frontend/server.js"]
