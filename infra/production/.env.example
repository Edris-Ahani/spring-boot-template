API_IMAGE=ghcr.io/your-organization/foundry-api@sha256:replace-with-published-digest
WEB_IMAGE=ghcr.io/your-organization/foundry-web@sha256:replace-with-published-digest
DATABASE_URL=jdbc:postgresql://database.example.com:5432/platform?sslmode=verify-full
DATABASE_USERNAME=platform_runtime
DATABASE_PASSWORD_FILE=/run/platform-secrets/database-password
OIDC_ISSUER_URI=https://identity.example.com/realms/platform
OIDC_JWK_SET_URI=https://identity.example.com/realms/platform/protocol/openid-connect/certs
OIDC_AUDIENCE=platform-api
