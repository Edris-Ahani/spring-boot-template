{
  "name": "@platform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:api-reference": "playwright test --config playwright.api.config.ts",
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api.generated.ts",
    "api:check": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api.generated.ts --check"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.24",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
